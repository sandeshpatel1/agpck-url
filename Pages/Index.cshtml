@page
@model IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Agro Pack - Product URL Manager</title>
    <link href="/css/site.css" rel="stylesheet" />
</head>
<body>
    <header class="topbar">
        <div class="topbar-inner">
            <div class="logo" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
            </div>
            <div>
                <h1>Product URL Manager</h1>
                <p>Select a table, find a product, preview its document and attach a URL</p>
            </div>
        </div>
    </header>

    <main class="wrap layout">

        <!-- LEFT: the flow -->
        <div class="side">
            <section class="panel">
                <div class="field">
                    <label for="ddlTable"><span class="step">1</span> Table</label>
                    <div class="select">
                        <select id="ddlTable">
                            <option value="">Select a table...</option>
                            @foreach (var t in Model.Tables)
                            {
                                <option value="@t">@t.Replace("_", " ")</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="field">
                    <label for="txtProduct"><span class="step">2</span> Product name</label>
                    <div class="ac" id="acBox">
                        <svg class="ico" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                        <input type="text" id="txtProduct" class="input" autocomplete="off"
                               placeholder="Select a table first..." disabled="disabled" />
                        <span class="spinner"></span>
                        <div id="suggestions" class="suggestions" style="display:none"></div>
                    </div>
                </div>

                <div id="status" class="status"></div>
            </section>

            <section id="productCard" class="panel product" style="display:none">
                <div class="step-title"><span class="step">3</span> Product details</div>

                <h2 id="fName"></h2>
                <div class="skurow">
                    <span class="k">Product code</span>
                    <span id="fSku" class="badge"></span>
                </div>

                <div class="urlbox">
                    <span class="k">URL</span>
                    <div class="urlrow">
                        <span id="fUrl" class="urltext"></span>
                        <button type="button" id="btnCopy" class="btn ghost small">Copy</button>
                    </div>
                </div>

                <div id="addUrl" class="addurl" style="display:none">
                    <div class="addurl-title">No URL saved for this product</div>
                    <p>Paste the link and save it. The preview will open on the right.</p>
                    <input type="text" id="txtNewUrl" class="input plain" placeholder="https://..." />
                    <button type="button" id="btnSave" class="btn block">Save URL</button>
                </div>
            </section>
        </div>

        <!-- RIGHT: the preview -->
        <section class="panel preview-panel">
            <div class="pv-bar">
                <span id="pvTitle" class="tag">Preview</span>
                <a id="pvOpen" class="pv-open" target="_blank" rel="noopener noreferrer" style="display:none">Open in new tab</a>
            </div>
            <div id="preview" class="pv-body"></div>
        </section>

    </main>

    <script src="/js/app.js"></script>
</body>
</html>
